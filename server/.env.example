PORT=4000

# One of the following must be set for Firebase Admin to authenticate:
# 1) Inline JSON (single line) service account
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"YOUR_PROJECT_ID","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n","client_email":"...","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token","auth_provider_x509_cert_url":"https://www.googleapis.com/oauth2/v1/certs","client_x509_cert_url":"..."}

# 2) Base64-encoded JSON service account
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwiLi4uIn0=

# 3) Or rely on GOOGLE_APPLICATION_CREDENTIALS pointing to a JSON file path
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/serviceAccount.json